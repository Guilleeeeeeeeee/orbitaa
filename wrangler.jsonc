{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbitaa",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": {"crons":["23 21,22 * * *","5-19 11 10 10 *"]},
  "assets": {"directory":"./dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB", "database_name":"orbita-db", "database_id":"19341953-c1f8-48e3-9e2d-9b5dec6231c4", "migrations_dir":"migrations"}]
}
