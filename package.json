{
  "name": "orbitaa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide": "^0.468.0",
    "three": "^0.180.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  },
  "cloudflare": {
    "bindings": {
      "ORBITA_PASSWORD": {
        "description": "Elige tu clave privada para entrar en \u00d3rbita desde el ordenador y el iPhone. Usa al menos 16 caracteres y no reutilices otra contrase\u00f1a."
      },
      "DB": {
        "description": "Base de datos privada para guardar tus viajes, h\u00e1bitos, tareas y diario."
      }
    }
  }
}
